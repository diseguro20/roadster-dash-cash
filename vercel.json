{
  "version": 2,
  "regions": ["gru1"],
  "rewrites": [
    {
      "source": "/(assets|icons|items)/:match*",
      "destination": "/$1/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
