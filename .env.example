PORT=3005
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here

# VizzionPay
VIZZIONPAY_API_KEY=your_vizzionpay_api_key
VIZZIONPAY_API_SECRET=your_vizzionpay_api_secret
VIZZIONPAY_API_URL=https://app.vizzionpay.com.br
VIZZIONPAY_WEBHOOK_URL=https://your-domain.vercel.app/api/webhook/vizzionpay

# Amplo Pay
AMPLOPAY_API_KEY=your_amplopay_public_key
AMPLOPAY_API_SECRET=your_amplopay_secret_key
AMPLOPAY_API_URL=https://app.amplopay.com
AMPLOPAY_WEBHOOK_URL=https://your-domain.vercel.app/api/webhook/amplopay
AMPLO_PERCENT=40

# Firebase
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
